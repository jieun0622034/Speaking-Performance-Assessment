{
  "name": "speaking-performance-assessment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "node scripts/backend.mjs spring-boot:run",
    "build": "npm run build --workspace frontend",
    "build:backend": "node scripts/backend.mjs package -DskipTests",
    "build:all": "npm run build && npm run build:backend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run typecheck",
    "test": "npm run test --workspace frontend",
    "test:backend": "node scripts/backend.mjs test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
