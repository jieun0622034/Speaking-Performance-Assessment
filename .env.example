# Copy to .env.local at the repository root. Never commit real credentials.
FRONTEND_PORT=5173
BACKEND_PORT=8080
BACKEND_URL=http://127.0.0.1:8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
VITE_BASE_PATH=/

# Optional Postgres profile: set SPRING_PROFILES_ACTIVE=postgres
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://127.0.0.1:5432/speaking_assessment
DB_USER=speaking
DB_PASSWORD=local-development-only

# AI calls are not implemented in Spring Boot yet. Keep secrets server-side.
# GEMINI_API_KEY=

# Local profile uses a persistent file DB independent of DB_URL above.
# LOCAL_DB_URL=jdbc:h2:file:./data/speaking;MODE=PostgreSQL;DB_CLOSE_ON_EXIT=FALSE
# LOCAL_DB_PASSWORD=
# MEDIA_DIRECTORY=./data/media
# Production requires HTTPS, SPRING_PROFILES_ACTIVE=production,
# DB_URL/DB_USER/DB_PASSWORD and an absolute persistent MEDIA_DIRECTORY.
# SESSION_COOKIE_SECURE=true
